# FigureLab environment file. Copy to `.env` and fill in what you need.
#
# The backend loads the first `.env` it finds (backend/.env, then the repo-root
# .env). Real environment variables always win over these files, and neither is
# ever committed (`.env` is gitignored).

# OpenAI API key for the real providers (`decisions` / `structured`).
OPENAI_API_KEY=

# auto | fake | decisions | structured.
# `auto` uses `fake` when no key is set, otherwise routes per request.
FIGURELAB_PROVIDER=auto

# --- optional overrides ---
# OPENAI_BASE_URL=https://api.openai.com
# FIGURELAB_CONFIDENCE_THRESHOLD=0.5
# FIGURELAB_DATA_DIR=backend/data
# FIGURELAB_DB_PATH=backend/data/figurelab.sqlite
